{
  "name": "@dm/kchart",
  "version": "9.9.1-beta.30",
  "description": "Lightweight k-line chart built with html5 canvas",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "NOTICE",
    "licenses/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/klinecharts/KLineChart"
  },
  "bugs": {
    "url": "https://github.com/klinecharts/KLineChart/issues"
  },
  "homepage": "https://klinecharts.com/",
  "keywords": [
    "k-line",
    "kline",
    "time-line",
    "candlestick",
    "indicator",
    "finance",
    "klinechart",
    "stockchart",
    "stock",
    "chart",
    "canvas",
    "trading",
    "technical-analysis"
  ],
  "author": "liihuu",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:watch": "vite build --watch",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "docs:preview": "npm run preview --prefix docs",
    "docs:deploy": "npm run docs:build && gh-pages -d website"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.1",
    "@eslint/js": "^10.0.1",
    "@shikijs/vitepress-twoslash": "^4.0.1",
    "@stackblitz/sdk": "^1.11.0",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/node": "^25.3.5",
    "@vitest/browser-playwright": "^4.1.1",
    "@vitest/coverage-v8": "^4.1.1",
    "@vitest/ui": "4.1.1",
    "codesandbox": "^2.2.3",
    "eslint": "^10.0.2",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.1"
  }
}
