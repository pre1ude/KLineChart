{
  "name": "@dm/kchart",
  "version": "9.9.1-beta.16",
  "description": "Lightweight k-line chart built with html5 canvas",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "NOTICE",
    "licenses/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/klinecharts/KLineChart"
  },
  "bugs": {
    "url": "https://github.com/klinecharts/KLineChart/issues"
  },
  "homepage": "https://klinecharts.com/",
  "keywords": [
    "k-line",
    "kline",
    "time-line",
    "candlestick",
    "indicator",
    "finance",
    "klinechart",
    "stockchart",
    "stock",
    "chart",
    "canvas",
    "trading",
    "technical-analysis"
  ],
  "author": "liihuu",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:watch": "vite build --watch",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "docs:preview": "npm run preview --prefix docs",
    "docs:deploy": "npm run docs:build && gh-pages -d website"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/standalone": "^7.25.9",
    "@eslint/js": "^9.14.0",
    "@shikijs/vitepress-twoslash": "^1.22.2",
    "@stackblitz/sdk": "^1.11.0",
    "@stylistic/eslint-plugin": "^2.10.1",
    "@types/node": "^22.12.0",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "4.0.17",
    "codesandbox": "^2.2.3",
    "eslint": "^9.39.1",
    "gh-pages": "^6.2.0",
    "husky": "^9.1.6",
    "resize-observer-polyfill": "^1.5.1",
    "terser": "^5.36.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.3.0",
    "vitepress": "^1.5.0",
    "vitest": "^4.0.17"
  }
}
